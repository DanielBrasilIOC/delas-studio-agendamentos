const TZ='America/Sao_Paulo';
const SHEETS={BOOKINGS:'Agendamentos',SERVICES:'Serviços',BLOCKS:'Bloqueios',AUDIT:'Auditoria'};
function setup(){
  const p=PropertiesService.getScriptProperties();let id=p.getProperty('SPREADSHEET_ID');
  let ss=id?SpreadsheetApp.openById(id):SpreadsheetApp.create("D'ELAS — Gestão de Agendamentos");
  p.setProperty('SPREADSHEET_ID',ss.getId());
  ensure_(ss,SHEETS.BOOKINGS,['ID','Criado em','Nome','WhatsApp','Serviço','Comprimento','Data','Início','Fim','Observações','Status','Criado por']);
  ensureBookingColumns_(ss);
  ensure_(ss,SHEETS.SERVICES,['Serviço','Preço (R$)','Tipo de preço','Duração (min)','Ativo']);
  ensureServiceColumns_(ss);
  ensure_(ss,SHEETS.BLOCKS,['Data','Início','Fim','Motivo','Criado por']);
  ensure_(ss,SHEETS.AUDIT,['Data/hora','Administrador','Ação','ID do agendamento','Detalhes']);
  seedServices_(ss);return {spreadsheetId:ss.getId(),url:ss.getUrl()};
}
function ensure_(ss,name,headers){let sh=ss.getSheetByName(name)||ss.insertSheet(name);if(sh.getLastRow()===0)sh.appendRow(headers);return sh;}
function ensureServiceColumns_(ss){const sh=ss.getSheetByName(SHEETS.SERVICES);if(sh.getLastColumn()<6)sh.insertColumnAfter(sh.getLastColumn());if(sh.getRange(1,6).getValue()!=='Descrição')sh.getRange(1,6).setValue('Descrição');}
function ensureBookingColumns_(ss){const sh=ss.getSheetByName(SHEETS.BOOKINGS);const h=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0];[['Estimativa (R$)',13],['Detalhamento do preço',14]].forEach(([name,col])=>{if(!h.includes(name)){if(sh.getLastColumn()<col)sh.insertColumnsAfter(sh.getLastColumn(),col-sh.getLastColumn());sh.getRange(1,col).setValue(name);}});}
function seedServices_(ss){
 const sh=ss.getSheetByName(SHEETS.SERVICES);if(sh.getLastRow()>1)return;
 const rows=[['CORTE COM SECAGEM',80,'A partir de',60,true],['CORTE COM ESCOVA',120,'A partir de',75,true],['CORTE TRATAMENTO (com secagem)',170,'A partir de',90,true],['ESCOVA',70,'A partir de',45,true],['APLICAÇÃO DE TINTURA',90,'A partir de',90,true],['RETOQUE',70,'A partir de',90,true],['TINTURA COMPLETA',120,'A partir de',120,true],['TUBO EXTRA DE TINTA (unidade)',40,'Fixo',15,true],['PRANCHA',25,'A partir de',30,true],['BABYLISS',35,'A partir de',30,true],['PROGRESSIVA — CURTO',160,'Fixo',150,true],['PROGRESSIVA — MÉDIO',190,'Fixo',180,true],['PROGRESSIVA — LONGO',250,'Fixo',210,true],['PROGRESSIVA — adicional extra longo/volumoso',30,'Adicional',30,true],['MECHAS — CURTO',350,'Fixo',240,true],['MECHAS — MÉDIO',400,'Fixo',270,true],['MECHAS — LONGO',550,'Fixo',300,true],['MECHAS — adicional extra longo/volumoso',50,'Adicional',30,true],['MORENA ILUMINADA',300,'A partir de',240,true],['LINHA GOLD (Wella, L’Oréal, Sebastian e Aneethun)',150,'Fixo',90,true],['LINHA BRANCA',120,'Fixo',75,true],['CRONOGRAMA CAPILAR — 4 SESSÕES',430,'Fixo',60,true]];
 sh.getRange(2,1,rows.length,5).setValues(rows);
}
function doGet(e){
 const page=e&&e.parameter&&e.parameter.page;
 if(page==='admin')return HtmlService.createTemplateFromFile('Index').evaluate().setTitle("D'ELAS | Gestão").addMetaTag('viewport','width=device-width, initial-scale=1');
 return HtmlService.createTemplateFromFile('Public').evaluate().setTitle("D'ELAS | Agendamento").addMetaTag('viewport','width=device-width, initial-scale=1');
}
function api(action,data,token){
 if(action==='catalog')return catalog_();
  if(action==='adminCatalog'){auth_(token);return adminCatalog_();}
  if(action==='blocks'){auth_(token);return blocks_();}
  if(action==='audit'){auth_(token);return auditList_();}
 if(action==='slots')return slots_(data.date,data.services||data.service,data.extraLong===true);
 auth_(token);
 if(action==='list')return list_(data||{});
 if(action==='updateStatus')return updateStatus_(data);
 if(action==='createManual')return createBooking_(data,true);
 if(action==='block')return block_(data);
 if(action==='saveService')return saveService_(data);
 if(action==='deleteBlock')return deleteBlock_(data);
 throw new Error('Ação não reconhecida.');
}
function publicBooking(data){return createBooking_(data,false);}
function ss_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('Execute setup() primeiro.');return SpreadsheetApp.openById(id);}
function auth_(token){const p=PropertiesService.getScriptProperties();if(!token||![p.getProperty('ADMIN_TOKEN_1'),p.getProperty('ADMIN_TOKEN_2')].includes(token))throw new Error('Acesso administrativo não autorizado.');}
function catalog_(){return readServices_().filter(r=>r.active).map(({name,price,priceType,duration,description})=>({name,price,priceType,duration,description}));}
function adminCatalog_(){return readServices_();}
function readServices_(){const sh=ss_().getSheetByName(SHEETS.SERVICES);return sh.getDataRange().getValues().slice(1).filter(r=>r[0]).map(r=>({name:String(r[0]),price:Number(r[1])||0,priceType:String(r[2]||'Fixo'),duration:Number(r[3])||30,active:r[4]===true,description:String(r[5]||'')}));}
function blocks_(){return ss_().getSheetByName(SHEETS.BLOCKS).getDataRange().getValues().slice(1).filter(r=>r[0]).map(r=>({date:dateKey_(r[0]),start:timeKey_(r[1]),end:timeKey_(r[2]),reason:r[3]||''})).sort((a,b)=>(a.date+a.start).localeCompare(b.date+b.start));}
function auditList_(){return ss_().getSheetByName(SHEETS.AUDIT).getDataRange().getValues().slice(1).filter(r=>r[0]).slice(-200).reverse().map(r=>({at:r[0] instanceof Date?Utilities.formatDate(r[0],TZ,'dd/MM/yyyy HH:mm'):String(r[0]),who:r[1],action:r[2],id:r[3],detail:r[4]}));}
function selectedServices_(d){let names=Array.isArray(d.services)?d.services:(d.service?[d.service]:[]);names=names.map(x=>String(x||'').trim()).filter(Boolean);if(!names.length||names.length>10||new Set(names).size!==names.length)throw new Error('Selecione de 1 a 10 serviços diferentes.');const all=readServices_();const selected=names.map(n=>all.find(s=>s.name===n&&s.active&&s.priceType!=='Adicional'));if(selected.some(x=>!x))throw new Error('Um dos serviços selecionados está indisponível. Atualize o catálogo.');return selected;}
function pricing_(selected,extraLong){let total=0,variable=false,details=[];selected.forEach(s=>{total+=s.price;if(s.priceType==='A partir de')variable=true;details.push(s.name+': '+(s.priceType==='A partir de'?'a partir de ':'')+'R$ '+s.price.toFixed(2).replace('.',','));});let add=0,addDuration=0;if(extraLong){if(selected.some(s=>s.name.startsWith('PROGRESSIVA —'))) {let a=readServices_().find(s=>s.name==='PROGRESSIVA — adicional extra longo/volumoso');if(a&&a.active){add+=a.price;addDuration+=a.duration;details.push('Adicional progressiva: R$ '+a.price.toFixed(2).replace('.',','));}}if(selected.some(s=>s.name.startsWith('MECHAS —'))){let a=readServices_().find(s=>s.name==='MECHAS — adicional extra longo/volumoso');if(a&&a.active){add+=a.price;addDuration+=a.duration;details.push('Adicional mechas: R$ '+a.price.toFixed(2).replace('.',','));}}}return {total:total+add,variable,details:details.join(' | '),duration:selected.reduce((n,s)=>n+s.duration,0)+addDuration};}
function slots_(date,services,extraLong){if(!date||!/^\d{4}-\d{2}-\d{2}$/.test(date))throw new Error('Data inválida.');const d=new Date(date+'T12:00:00'),day=d.getDay();if(day===0||day===1)return [];const selected=selectedServices_({services:services,service:services});const price=pricing_(selected,extraLong===true);const sh=ss_().getSheetByName(SHEETS.BOOKINGS),rows=sh.getDataRange().getValues().slice(1),blocks=ss_().getSheetByName(SHEETS.BLOCKS).getDataRange().getValues().slice(1),out=[];for(let m=540;m<1080;m+=30){let end=m+price.duration;if(end>1080)continue;let start=strTime_(m),finish=strTime_(end);let busy=rows.some(r=>dateKey_(r[6])===date&&!['Cancelado'].includes(r[10])&&overlap_(start,finish,timeKey_(r[7]),timeKey_(r[8])));let blocked=blocks.some(r=>dateKey_(r[0])===date&&overlap_(start,finish,timeKey_(r[1]),timeKey_(r[2])));if(!busy&&!blocked)out.push(start);}return out;}

function createBooking_(d,manual){const lock=LockService.getScriptLock();lock.waitLock(20000);try{const date=String(d.date||''),day=new Date(date+'T12:00:00').getDay(),today=Utilities.formatDate(new Date(),TZ,'yyyy-MM-dd');if(date<today)throw new Error('Não é possível agendar em uma data passada.');if(!d.name||!d.phone||!/^\d{4}-\d{2}-\d{2}$/.test(date)||day===0||day===1)throw new Error('Confira os dados e escolha uma data de terça a sábado.');const selected=selectedServices_(d),extraLong=d.extraLong===true,price=pricing_(selected,extraLong),start=String(d.time||'');if(!/^([0-1]\d|2[0-3]):[0-5]\d$/.test(start))throw new Error('Horário inválido.');const mins=Number(start.slice(0,2))*60+Number(start.slice(3)),end=mins+price.duration;if(mins<540||end>1080)throw new Error('O conjunto de serviços não cabe nesse horário de funcionamento.');const finish=strTime_(end),sh=ss_().getSheetByName(SHEETS.BOOKINGS),rows=sh.getDataRange().getValues().slice(1),conflict=rows.some(r=>dateKey_(r[6])===date&&!['Cancelado'].includes(r[10])&&overlap_(start,finish,timeKey_(r[7]),timeKey_(r[8]))),blocked=ss_().getSheetByName(SHEETS.BLOCKS).getDataRange().getValues().slice(1).some(r=>dateKey_(r[0])===date&&overlap_(start,finish,timeKey_(r[1]),timeKey_(r[2])));if(conflict||blocked)throw new Error('Este horário não está mais disponível. Escolha outro.');const id=Utilities.getUuid(),status=manual?'Confirmado':'Pendente de confirmação',names=selected.map(s=>s.name).join(' + '),length=extraLong?'Extra longo/volumoso (adicional aplicado)':'';sh.appendRow([id,new Date(),String(d.name).slice(0,100),String(d.phone).slice(0,25),names,length,date,start,finish,String(d.notes||'').slice(0,500),status,manual?'Admin':'Cliente',price.total,price.details+(price.variable?' | Valor sujeito à avaliação':'')]);audit_(manual?'Admin':'Cliente',manual?'Criação manual':'Novo pedido',id,names+'; estimativa R$ '+price.total.toFixed(2));return {ok:true,id,status,priceEstimate:price.total,priceDetails:price.details,variablePrice:price.variable,duration:price.duration};}finally{lock.releaseLock();}}

function list_(filters){const sh=ss_().getSheetByName(SHEETS.BOOKINGS);const all=sh.getDataRange().getValues();return all.slice(1).map(r=>({id:r[0],created:r[1] instanceof Date?Utilities.formatDate(r[1],TZ,'dd/MM/yyyy HH:mm'):r[1],name:r[2],phone:r[3],service:r[4],length:r[5],date:dateKey_(r[6]),start:timeKey_(r[7]),end:timeKey_(r[8]),notes:r[9],status:r[10],priceEstimate:Number(r[12])||null,priceDetails:r[13]||''})).filter(r=>(!filters.date||r.date===filters.date)&&(!filters.from||r.date>=filters.from)&&(!filters.to||r.date<=filters.to)&&(!filters.status||r.status===filters.status)&&(!filters.q||[r.name,r.phone,r.service,r.id].join(' ').toLowerCase().includes(String(filters.q).toLowerCase()))).sort((a,b)=>(a.date+a.start).localeCompare(b.date+b.start));}
function updateStatus_(d){const sh=ss_().getSheetByName(SHEETS.BOOKINGS),v=sh.getDataRange().getValues();const i=v.findIndex(r=>r[0]===d.id);if(i<1)throw new Error('Agendamento não encontrado.');const allowed=['Pendente de confirmação','Confirmado','Concluído','Cancelado','Não compareceu'];if(!allowed.includes(d.status))throw new Error('Status inválido.');sh.getRange(i+1,11).setValue(d.status);audit_('Admin','Alteração de status',d.id,d.status);return {ok:true};}
function saveService_(d){const sh=ss_().getSheetByName(SHEETS.SERVICES),v=sh.getDataRange().getValues(),i=v.findIndex((r,n)=>n>0&&r[0]===d.name);if(i<1)throw new Error('Serviço não encontrado.');const price=Number(d.price),duration=Number(d.duration),types=['Fixo','A partir de','Adicional'];if(!Number.isFinite(price)||price<0||!Number.isFinite(duration)||duration<15||!types.includes(d.priceType))throw new Error('Preço, tipo ou duração inválidos.');sh.getRange(i+1,2,1,5).setValues([[price,d.priceType,duration,d.active===true,String(d.description||'').slice(0,300)]]);audit_('Admin','Edição de serviço',d.name,'Preço/duração/ativo/descrição');return {ok:true};}

function block_(d){const lock=LockService.getScriptLock();lock.waitLock(20000);try{const date=String(d.date||''),start=String(d.start||''),end=String(d.end||'');const day=new Date(date+'T12:00:00').getDay();const today=Utilities.formatDate(new Date(),TZ,'yyyy-MM-dd');if(!/^\d{4}-\d{2}-\d{2}$/.test(date)||date<today||day===0||day===1||!/^([0-1]\d|2[0-3]):[0-5]\d$/.test(start)||!/^([0-1]\d|2[0-3]):[0-5]\d$/.test(end)||start>=end||start<'09:00'||end>'18:00')throw new Error('Informe uma data e um intervalo válido, dentro do expediente.');const sh=ss_().getSheetByName(SHEETS.BOOKINGS);const busy=sh.getDataRange().getValues().slice(1).some(r=>dateKey_(r[6])===date&&!['Cancelado'].includes(r[10])&&overlap_(start,end,timeKey_(r[7]),timeKey_(r[8])));if(busy)throw new Error('Já existe agendamento nesse intervalo.');const bs=ss_().getSheetByName(SHEETS.BLOCKS);const existing=bs.getDataRange().getValues().slice(1).some(r=>dateKey_(r[0])===date&&overlap_(start,end,timeKey_(r[1]),timeKey_(r[2])));if(existing)throw new Error('Este intervalo já está bloqueado.');bs.appendRow([date,start,end,String(d.reason||'').slice(0,200),'Admin']);audit_('Admin','Bloqueio de horário',date,start+'-'+end);return {ok:true};}finally{lock.releaseLock();}}
function deleteBlock_(d){const sh=ss_().getSheetByName(SHEETS.BLOCKS),v=sh.getDataRange().getValues();const i=v.findIndex((r,n)=>n>0&&dateKey_(r[0])===d.date&&timeKey_(r[1])===d.start);if(i<1)throw new Error('Bloqueio não encontrado.');sh.deleteRow(i+1);audit_('Admin','Remoção de bloqueio',d.date,d.start);return {ok:true};}
function audit_(who,action,id,detail){ss_().getSheetByName(SHEETS.AUDIT).appendRow([new Date(),who,action,id,detail]);}
function dateKey_(v){if(v instanceof Date)return Utilities.formatDate(v,TZ,'yyyy-MM-dd');const s=String(v||'').trim();if(/^\d{4}-\d{2}-\d{2}$/.test(s))return s;return s;}
function timeKey_(v){if(v instanceof Date)return Utilities.formatDate(v,TZ,'HH:mm');const s=String(v||'').trim();const m=s.match(/^(\d{1,2}):(\d{2})/);return m?String(m[1]).padStart(2,'0')+':'+m[2]:s;}
function overlap_(a,b,c,d){return a<d&&c<b;}
function strTime_(m){return String(Math.floor(m/60)).padStart(2,'0')+':'+String(m%60).padStart(2,'0');}
